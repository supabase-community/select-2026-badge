# What tools/build.py creates locally. Build output is never committed to this
# repository: the export is SOURCE, MANIFEST.json hashes every published file,
# and a compiled artifact beside the source would be stale the moment either
# the source or the compiler pin moved.
build/
__pycache__/
*.pyc

# Exact root-local operator artifacts. The archive is disposable output and the
# populated provisioning file is protected input; neither is source or a build
# input, and tools/build.py never copies either into /system.
/build.zip
/secrets.prod.py
